<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Used to take a profile photo</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to choose a profile photo from your library</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SENTRY_ENV</key>
	<string>$(SENTRY_ENV)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>MAPS_API_KEY</key>
	<string>$(MAPS_API_KEY)</string>	
	<!-- ridly:// deep link for Supabase email-confirmation callbacks -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.hop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ridly</string>
			</array>
		</dict>
	</array>
	<!-- URL schemes the app is allowed to query (required for canOpenURL on iOS 9+) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mobilepay</string>
		<string>vipps</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>nunito_black.ttf</string>
	</array>
</dict>
</plist>
